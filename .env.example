# Copy to .env.local (gitignored) and fill in. Set the same vars per-environment in the Vercel dashboard.
# NEVER commit real secrets. Server-only secrets have plain names; values exposed to the browser must be NEXT_PUBLIC_*.

# Public canonical site URL (used by metadataBase, sitemap, robots, RSS, canonical URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (https://resend.com) — server-only. Used by the contact form Server Action.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# The verified sender address Resend will send from (e.g. "Acme <hello@yourdomain.com>").
RESEND_FROM=Acme Website <hello@example.com>
# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=enquiries@example.com
